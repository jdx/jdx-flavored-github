{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": ["chrome", "node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
