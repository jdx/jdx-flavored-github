{
  "name": "jdx-flavored-github",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "aube run build && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "aube@1.36.0",
  "aube": {
    "allowBuilds": {
      "esbuild": true
    }
  }
}
