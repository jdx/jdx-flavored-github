{
	"name": "jdx-flavored-github",
	"private": true,
	"packageManager": "aube@1.36.0",
	"scripts": {
		"build": "tsc --noEmit && node scripts/build.mjs",
		"dev": "node scripts/build.mjs --watch",
		"test": "aube run build && tsx --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"type": "module",
	"devDependencies": {
		"@types/chrome": "^0.2.2",
		"@types/node": "^26.1.2",
		"esbuild": "^0.28.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2"
	},
	"aube": {
		"allowBuilds": {
			"esbuild": true
		}
	}
}
